# ==============================================================================
# Kairo — Free-Tier & Zero-Key Configuration
# ==============================================================================
# Works 100% free out-of-the-box using local Ollama + DuckDuckGo (no API keys).
# For sub-second cloud speed (still $0 free tier), set GROQ_API_KEY or GEMINI_API_KEY
# and switch LLM_PROVIDER=groq (or gemini / openrouter).

# Provider options: auto | ollama | groq | gemini | openrouter | openai_compat
LLM_PROVIDER=auto

# --- Option 1: Local Ollama (100% free, zero API keys, runs locally) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=mistral:latest
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# --- Option 2: Groq Free Tier (Fastest cloud inference - free key at console.groq.com) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Option 3: Google Gemini Free Tier (Free key at aistudio.google.com) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Option 4: OpenRouter Free Models (Free models ending in :free) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Optional Custom OpenAI-Compatible Endpoint ---
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ==============================================================================
# Search Provider (Strictly 1 Tool: web_search)
# ==============================================================================
# Options: auto | duckduckgo | tavily | brave
# 'auto' uses Tavily/Brave if key is set, otherwise DuckDuckGo zero-key fallback.
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_API_KEY=

# ==============================================================================
# Runtime & Memory Settings
# ==============================================================================
DATABASE_PATH=data/kairo.db
DEFAULT_TIMEZONE=Asia/Kolkata
MAX_SEARCH_ROUNDS=2
SEARCH_TIMEOUT_SECONDS=6.0
PAGE_EXTRACT_TIMEOUT_SECONDS=1.8
ENABLE_PAGE_EXTRACTION=true
SEARCH_CACHE_TTL_SECONDS=3600
BREAKING_CACHE_TTL_SECONDS=300
HOST=0.0.0.0
PORT=8000
